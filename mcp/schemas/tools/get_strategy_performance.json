{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy_id": {
      "type": "string",
      "enum": [
        "ema_trend_follow_v1",
        "rsi_mean_reversion_v1",
        "range_breakout_v1"
      ]
    },
    "symbol": {
      "type": "string"
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ]
    }
  },
  "required": [
    "strategy_id"
  ],
  "additionalProperties": false
}
