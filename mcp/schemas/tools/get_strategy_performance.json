{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9_]+_v\\d+$",
      "description": "Server-validated catalog strategy id (e.g. ema_trend_follow_v1). Discover valid ids and their evidence with get_strategy_performance; unknown ids are rejected server-side."
    },
    "symbol": {
      "type": "string"
    },
    "timeframe": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ]
    }
  },
  "required": [
    "strategy_id"
  ],
  "additionalProperties": false
}
