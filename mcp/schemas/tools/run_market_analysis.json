{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "const": "forex"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "oanda",
        "ea"
      ]
    },
    "layout_id": {
      "description": "User chart layout id (from list_chart_layouts) — defaults to primary chart",
      "type": "string",
      "pattern": "^[A-Za-z0-9]{8,16}$"
    }
  },
  "additionalProperties": false
}
