{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "crypto",
        "forex"
      ]
    },
    "layout_id": {
      "description": "معرّف شارت المستخدم (من list_chart_layouts) — الافتراضي شارته الأساسي",
      "type": "string",
      "pattern": "^[A-Za-z0-9]{8,16}$"
    }
  },
  "required": [
    "symbol"
  ],
  "additionalProperties": false
}
