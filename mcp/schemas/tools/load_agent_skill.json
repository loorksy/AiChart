{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "description": "Skill name from list_agent_skills or resolve_agent_skills"
    },
    "version": {
      "description": "Optional exact version (defaults to latest)",
      "type": "string",
      "maxLength": 32
    }
  },
  "required": [
    "name"
  ]
}
