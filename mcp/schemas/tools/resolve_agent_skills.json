{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "The operator's current request / message"
    },
    "intents": {
      "description": "Optional soft intent hints (e.g. analysis, recommendation)",
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ]
    },
    "market": {
      "description": "Defaults to forex",
      "type": "string",
      "maxLength": 32
    },
    "max_skills": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "allow_execution_skills": {
      "description": "Only true when execution tools are authorized; still subject to Risk/Execution Guard",
      "type": "boolean"
    }
  },
  "required": [
    "request"
  ]
}
