{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbols": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interval": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "crypto",
        "forex"
      ]
    }
  },
  "additionalProperties": false
}
