{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "buy",
        "sell",
        "wait"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "factors": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "timeframe": {
      "type": "string"
    },
    "pattern_name": {
      "type": "string"
    },
    "chart_drawings": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "symbol",
    "action",
    "confidence",
    "rationale",
    "factors"
  ],
  "additionalProperties": false
}
