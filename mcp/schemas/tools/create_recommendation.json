{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "buy",
        "sell",
        "wait"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "factors": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeframe": {
      "type": "string"
    },
    "pattern_name": {
      "type": "string"
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "chart_drawings": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "strategy_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9_]+_v\\d+$",
      "description": "Server-validated catalog strategy id (e.g. ema_trend_follow_v1). Discover valid ids and their evidence with get_strategy_performance; unknown ids are rejected server-side."
    },
    "backtested_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "market_regime": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64
    },
    "entry": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stop_loss": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "take_profit": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "visual_confirmation": {
      "description": "Did the chart images agree with the numbers? confirmed | contradicted | not_checked. Contradicted lowers the DISPLAYED confidence; it never changes backtest evidence.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "confirmed",
            "contradicted",
            "not_checked"
          ]
        },
        {
          "type": "boolean"
        }
      ]
    },
    "timeframes_reviewed": {
      "description": "Timeframes actually reviewed visually before this call (e.g. [\"15m\",\"1h\",\"4h\",\"1D\"]). Audit trail only.",
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      }
    }
  },
  "required": [
    "symbol",
    "action",
    "rationale",
    "factors"
  ],
  "additionalProperties": false
}
