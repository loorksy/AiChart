{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "trading_style": {
      "type": "string",
      "enum": [
        "scalp",
        "day",
        "swing",
        "position"
      ]
    },
    "scalp_max_trades": {
      "description": "Concurrent trade cap — required for scalp",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "sync_interval": {
      "description": "Auto-set timeframe based on style",
      "type": "boolean"
    }
  },
  "required": [
    "trading_style"
  ],
  "additionalProperties": false
}
