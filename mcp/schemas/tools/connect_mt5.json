{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "mt4",
        "mt5"
      ]
    },
    "server": {
      "type": "string",
      "minLength": 2
    },
    "login": {
      "type": "string",
      "minLength": 1
    },
    "password": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "platform",
    "server",
    "login",
    "password"
  ]
}
