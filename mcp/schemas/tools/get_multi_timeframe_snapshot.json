{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "e.g. EURUSD"
    },
    "intervals": {
      "description": "Frame list, default 1h,15m,5m — max 5",
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "market": {
      "type": "string",
      "const": "forex"
    }
  },
  "required": [
    "symbol"
  ],
  "additionalProperties": false
}
