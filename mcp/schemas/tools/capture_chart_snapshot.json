{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "const": "forex"
    },
    "pattern_name": {
      "type": "string"
    },
    "chart_drawings": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "layout_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "platform",
        "mt5"
      ]
    },
    "inline_image": {
      "description": "Attach the chart as an inline image block so the assistant can see it (default false — the operator gets the image_url link either way).",
      "type": "boolean"
    }
  },
  "required": [
    "symbol"
  ]
}
