{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "market": {
      "type": "string",
      "const": "forex"
    },
    "entry": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "number"
    },
    "practice": {
      "type": "boolean"
    }
  },
  "required": [
    "symbol",
    "side",
    "stop_loss"
  ]
}
