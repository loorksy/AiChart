{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "notional": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "market": {
      "type": "string",
      "enum": [
        "crypto",
        "forex"
      ]
    },
    "entry": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "number"
    },
    "practice": {
      "type": "boolean"
    }
  },
  "required": [
    "symbol",
    "side"
  ],
  "additionalProperties": false
}
