{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "e.g. EURUSD"
    },
    "interval": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "const": "forex"
    }
  },
  "required": [
    "symbol"
  ]
}
