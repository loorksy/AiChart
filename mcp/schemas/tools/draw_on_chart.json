{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "layout_id": {
      "description": "User chart layout id (from list_chart_layouts) — defaults to primary chart",
      "type": "string",
      "pattern": "^[A-Za-z0-9]{8,16}$"
    },
    "symbol": {
      "description": "Change chart symbol (optional)",
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "dataSource": {
      "type": "string",
      "const": "oanda"
    },
    "mode": {
      "default": "set",
      "type": "string",
      "enum": [
        "set",
        "add"
      ]
    },
    "drawings": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Drawing type: price_line | trend_line | ray | channel | parallel_channel | regression_trend | zone | supply_zone | demand_zone | range_box | fib_retracement | forecast_path | polyline_pattern | triangle | neckline | long_position | short_position | labeled_arrow | arrow_up | arrow_down | text | pattern_label"
          },
          "confidence": {
            "default": 70,
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "label": {
            "description": "Label shown on chart",
            "type": "string",
            "maxLength": 64
          },
          "color": {
            "description": "Hex color e.g. #22c55e",
            "type": "string",
            "maxLength": 24
          },
          "width": {
            "description": "Line width 1–4",
            "type": "number",
            "minimum": 1,
            "maximum": 4
          },
          "style": {
            "type": "string",
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          },
          "fill": {
            "description": "Fill zones",
            "type": "boolean"
          },
          "fill_color": {
            "type": "string",
            "maxLength": 24
          },
          "semanticRole": {
            "description": "support | resistance | entry | stop_loss | take_profit | trendline | pattern | forecast",
            "type": "string",
            "maxLength": 32
          },
          "patternType": {
            "description": "e.g. double_bottom | head_and_shoulders | ascending_triangle",
            "type": "string",
            "maxLength": 40
          },
          "points": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "price": {
                  "type": "number",
                  "description": "Price"
                },
                "time": {
                  "description": "Unix time (seconds or ms) — required for historical points",
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "barsAhead": {
                  "description": "Bars ahead — for forecast_path future points only",
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "price"
              ]
            },
            "description": "Drawing points (time+price). long/short_position: entry point + meta"
          },
          "meta": {
            "description": "For positions: {entry, stopLoss, takeProfit}",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "points"
        ]
      }
    },
    "recommendation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "buy",
                "sell",
                "wait"
              ]
            },
            "entry": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stop_loss": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "take_profit": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "description": "Additional profit targets",
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "required": [
    "drawings"
  ]
}
