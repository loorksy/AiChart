{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiKey": {
      "type": "string",
      "minLength": 10
    },
    "apiSecret": {
      "type": "string",
      "minLength": 10
    },
    "env": {
      "type": "string",
      "enum": [
        "testnet",
        "prod"
      ]
    },
    "futuresRequired": {
      "type": "boolean"
    }
  },
  "required": [
    "apiKey",
    "apiSecret"
  ],
  "additionalProperties": false
}
