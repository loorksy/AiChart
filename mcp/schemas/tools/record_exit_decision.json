{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "trade_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "decision": {
      "type": "string",
      "enum": [
        "hold",
        "close",
        "adjust_sl"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "new_stop_loss": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "trade_id",
    "decision",
    "reason"
  ]
}
