{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "crypto",
        "forex"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500
    }
  },
  "required": [
    "symbol"
  ],
  "additionalProperties": false
}
