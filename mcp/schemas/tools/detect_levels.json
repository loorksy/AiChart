{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "market": {
      "type": "string",
      "const": "forex"
    },
    "limit": {
      "type": "integer",
      "minimum": 20,
      "maximum": 500
    }
  },
  "required": [
    "symbol"
  ]
}
