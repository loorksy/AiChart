{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "order_type": {
      "type": "string",
      "enum": [
        "limit",
        "stop",
        "stop_limit"
      ]
    },
    "lots": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stop_loss": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "take_profit": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "symbol",
    "side",
    "order_type",
    "lots",
    "price"
  ],
  "additionalProperties": false
}
