{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "description": "رمز الزوج — لفحص quote/spread",
      "type": "string"
    },
    "market": {
      "type": "string",
      "enum": [
        "crypto",
        "forex"
      ]
    },
    "confidence": {
      "description": "ثقة مقترحة — يُقارَن بـ min_confidence",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "practice": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
