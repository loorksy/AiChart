{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "description": "Pair symbol — for quote/spread check",
      "type": "string"
    },
    "market": {
      "type": "string",
      "const": "forex"
    },
    "confidence": {
      "description": "Proposed confidence — advisory estimate for the agent",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "practice": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
