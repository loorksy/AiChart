{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "volume": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "open_price": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "symbol",
    "side",
    "volume",
    "open_price"
  ]
}
