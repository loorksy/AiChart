{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "layout_id": {
      "description": "User chart layout id (from list_chart_layouts) — defaults to primary chart",
      "type": "string",
      "pattern": "^[A-Za-z0-9]{8,16}$"
    },
    "market": {
      "type": "string",
      "const": "forex"
    }
  }
}
