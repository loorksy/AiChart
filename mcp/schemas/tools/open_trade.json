{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "notional": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "lots": {
      "description": "forex: explicit lot size (overrides notional)",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "market": {
      "type": "string",
      "enum": [
        "crypto",
        "forex"
      ]
    },
    "entry": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "recommendation_id": {
      "type": "number"
    },
    "approved_by_user": {
      "type": "boolean"
    },
    "practice": {
      "type": "boolean"
    },
    "market_type": {
      "type": "string",
      "enum": [
        "spot",
        "futures"
      ]
    },
    "leverage": {
      "type": "number",
      "minimum": 1,
      "maximum": 125
    },
    "order_type": {
      "type": "string",
      "enum": [
        "market",
        "limit"
      ]
    },
    "limit_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "idempotencyKey": {
      "description": "idempotency 24h",
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "symbol",
    "side",
    "notional",
    "confidence",
    "rationale"
  ],
  "additionalProperties": false
}
