{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "market": {
      "type": "string",
      "const": "forex"
    },
    "entry": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number",
      "description": "Stop loss — mandatory, rejected without it"
    },
    "take_profit": {
      "type": "number"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "recommendation_id": {
      "type": "number"
    },
    "approved_by_user": {
      "type": "boolean"
    },
    "practice": {
      "type": "boolean"
    },
    "market_type": {
      "type": "string",
      "const": "spot"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "market",
        "limit"
      ]
    },
    "limit_price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "idempotencyKey": {
      "description": "idempotency 24h",
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "symbol",
    "side",
    "stop_loss",
    "confidence",
    "rationale"
  ]
}
