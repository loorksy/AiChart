{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "timeframe": {
      "type": "string"
    },
    "entry": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stop_loss": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "take_profit": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "take_profits": {
      "description": "Every profit target in order (TP1..TP3). take_profit is TP1.",
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "entry_type": {
      "description": "Your declared fill semantics (market | limit_touch | confirmation_close | retest_zone, broker spellings accepted). The server resolves the canonical type from the plan's structure — a close-based activation_rule always resolves to confirmation_close.",
      "type": "string",
      "maxLength": 32
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "immediate",
        "anticipatory",
        "conditional"
      ]
    },
    "timeframes_reviewed": {
      "description": "Timeframes actually reviewed visually before this call (e.g. [\"15m\",\"1h\",\"4h\",\"1D\"]). Audit trail only.",
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16
      }
    },
    "entry_low": {
      "description": "Lower bound of the entry ZONE. Omit for a single entry price.",
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        }
      ]
    },
    "entry_high": {
      "description": "Upper bound of the entry ZONE. Omit for a single entry price.",
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        }
      ]
    },
    "activation_condition": {
      "description": "REQUIRED for conditional and anticipatory plans: the exact event that turns the plan on, in the operator's language.",
      "type": "string",
      "minLength": 8,
      "maxLength": 400
    },
    "activation_rule": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "price_touch"
                },
                "level": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "above",
                    "below"
                  ]
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "level"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "candle_close_above"
                },
                "level": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "closes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "level"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "candle_close_below"
                },
                "level": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "closes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "level"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "breakout_confirmed"
                },
                "level": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "above",
                    "below"
                  ]
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "closes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "level",
                "direction"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "retest_confirmed"
                },
                "level": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "above",
                    "below"
                  ]
                },
                "retestZone": {
                  "type": "object",
                  "properties": {
                    "low": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "high": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "low",
                    "high"
                  ]
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "closes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "level",
                "direction",
                "retestZone"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "rejection_confirmed"
                },
                "level": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "above",
                    "below"
                  ]
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "timeframe": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "level",
                "direction"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "composite"
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "all",
                    "any"
                  ]
                },
                "rules": {
                  "minItems": 2,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "price_touch"
                          },
                          "level": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "direction": {
                            "type": "string",
                            "enum": [
                              "above",
                              "below"
                            ]
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0
                          },
                          "timeframe": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8
                          },
                          "expiresAt": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "kind",
                          "level"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "candle_close_above"
                          },
                          "level": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0
                          },
                          "closes": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10
                          },
                          "timeframe": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8
                          },
                          "expiresAt": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "kind",
                          "level"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "candle_close_below"
                          },
                          "level": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0
                          },
                          "closes": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10
                          },
                          "timeframe": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8
                          },
                          "expiresAt": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "kind",
                          "level"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "breakout_confirmed"
                          },
                          "level": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "direction": {
                            "type": "string",
                            "enum": [
                              "above",
                              "below"
                            ]
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0
                          },
                          "closes": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10
                          },
                          "timeframe": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8
                          },
                          "expiresAt": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "kind",
                          "level",
                          "direction"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "retest_confirmed"
                          },
                          "level": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "direction": {
                            "type": "string",
                            "enum": [
                              "above",
                              "below"
                            ]
                          },
                          "retestZone": {
                            "type": "object",
                            "properties": {
                              "low": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "high": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              }
                            },
                            "required": [
                              "low",
                              "high"
                            ]
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0
                          },
                          "closes": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10
                          },
                          "timeframe": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8
                          },
                          "expiresAt": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "kind",
                          "level",
                          "direction",
                          "retestZone"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "rejection_confirmed"
                          },
                          "level": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "direction": {
                            "type": "string",
                            "enum": [
                              "above",
                              "below"
                            ]
                          },
                          "tolerance": {
                            "type": "number",
                            "minimum": 0
                          },
                          "timeframe": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 8
                          },
                          "expiresAt": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "kind",
                          "level",
                          "direction"
                        ]
                      }
                    ]
                  }
                },
                "expiresAt": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "operator",
                "rules"
              ]
            }
          ],
          "description": "The activation condition as DATA, so the tracker can grade it. Pick the kind that matches your sentence exactly — price_touch ONLY if a bare touch is genuinely enough; candle_close_above/below need level+timeframe; retest_confirmed needs the retestZone band you expect the pullback into; rejection_confirmed means a wick through the level and a close back. Never emit a rule looser than your sentence."
        },
        {
          "type": "string",
          "description": "JSON-encoded activation_rule (stale cached schema compatibility)"
        }
      ]
    },
    "invalidation_rule": {
      "type": "string",
      "minLength": 8,
      "maxLength": 400,
      "description": "REQUIRED: what specifically kills this idea (e.g. a close beyond a level)."
    },
    "alternative_scenario": {
      "type": "string",
      "minLength": 8,
      "maxLength": 400,
      "description": "REQUIRED: the runner-up scenario and what would switch the plan to it."
    },
    "validity_candles": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 96
        },
        {
          "type": "string",
          "pattern": "^\\d{1,2}$"
        }
      ],
      "description": "REQUIRED: how many candles of THIS timeframe the plan stays meaningful (1..96)."
    }
  },
  "required": [
    "symbol",
    "direction",
    "entry",
    "stop_loss",
    "invalidation_rule",
    "alternative_scenario",
    "validity_candles"
  ]
}
