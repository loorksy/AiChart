{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string"
    },
    "interval": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "capture_key": {
      "type": "string"
    },
    "entry": {
      "type": "number"
    },
    "stop_loss": {
      "type": "number"
    },
    "take_profit": {
      "type": "number"
    },
    "drawings": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "inline_image": {
      "description": "Attach the chart as an inline image block so the assistant can see it (default false — the operator gets the image_url link either way).",
      "type": "boolean"
    }
  },
  "required": [
    "symbol"
  ]
}
