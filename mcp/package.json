{
  "name": "aichart-mcp",
  "version": "1.1.1",
  "description": "AiChart MCP Server — Claude Connectors bridge to /api/agent/*",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:catalog": "tsx --test src/tools/__tests__/catalog.test.ts",
    "schemas:export": "tsx scripts/export-schemas.mts",
    "schemas:check": "tsx scripts/export-schemas.mts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "better-sqlite3": "^11.10.0",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
