{
  "name": "AiChart EA Bridge API",
  "version": "1.0.0",
  "auth": {
    "scheme": "Bearer",
    "header": "Authorization",
    "value": "Bearer <EA_TOKEN>",
    "fallback_header": "X-EA-Token",
    "note": "Generate the token from AiChart → الإعدادات → الربط والتكامل → MetaTrader. Shown once."
  },
  "base_url": "https://aichart.lork.cloud",
  "endpoints": {
    "heartbeat": {
      "method": "POST",
      "path": "/api/ea/heartbeat",
      "interval_seconds": 2,
      "request": {
        "account": {
          "login": "string|number",
          "currency": "string",
          "balance": "number",
          "equity": "number",
          "broker": "string"
        },
        "symbols": [
          {
            "symbol": "EURUSD",
            "bid": 1.0853,
            "ask": 1.0854,
            "digits": 5,
            "point": 0.00001,
            "contract_size": 100000,
            "tick_value": 1.0,
            "tick_size": 0.00001,
            "min_lot": 0.01,
            "max_lot": 100.0,
            "lot_step": 0.01
          }
        ],
        "candles": {
          "symbol": "EURUSD",
          "interval": "1h",
          "bars": [{ "time": 1717000000, "open": 1.08, "high": 1.09, "low": 1.07, "close": 1.085 }]
        }
      },
      "response": {
        "ok": true,
        "server_time": "ISO8601",
        "commands": [
          {
            "id": 123,
            "type": "open_market",
            "payload": {
              "symbol": "EURUSD",
              "side": "buy",
              "lots": 0.10,
              "stop_loss": 1.08,
              "take_profit": 1.10
            }
          }
        ]
      }
    },
    "commands": {
      "method": "GET",
      "path": "/api/ea/commands",
      "note": "Alternative to commands embedded in the heartbeat response."
    },
    "ack": {
      "method": "POST",
      "path": "/api/ea/commands/{id}/ack",
      "request": {
        "status": "acked|failed",
        "result": { "ticket": 5566778, "price": 1.0854, "lots": 0.10, "error": "optional" }
      }
    },
    "chart_upload": {
      "method": "POST",
      "path": "/api/ea/chart-upload",
      "auth": "Bearer EA token",
      "content_type": "multipart/form-data",
      "request": {
        "recommendation_id": "number (required unless capture_key)",
        "capture_key": "string (optional, for ad-hoc snapshots e.g. snap_1717000000)",
        "chart": "PNG file field"
      },
      "response": {
        "ok": true,
        "path": "/data/charts/ea/{userId}/{id}.png"
      }
    }
  },
  "command_types": {
    "open_market": "Open a market order (side=buy|sell, lots, optional stop_loss/take_profit).",
    "close_position": "Close an open position by ticket.",
    "modify_sl_tp": "Modify stop loss / take profit of an open position.",
    "draw_and_capture": "Clear prior AICHART_* objects, draw chart_drawings on MT5 chart, ChartScreenShot, upload PNG.",
    "clear_chart": "Delete all chart objects with prefix AICHART_{recommendation_id}_ (or all AICHART_* if no id)."
  },
  "draw_and_capture_payload": {
    "symbol": "MT5 symbol e.g. EURUSD or BTCUSD",
    "interval": "1m|5m|15m|1h|4h|1d|1w",
    "recommendation_id": "number (links upload + object prefix)",
    "capture_key": "optional string when recommendation_id is 0",
    "entry": "optional number",
    "stop_loss": "optional number",
    "take_profit": "optional number",
    "drawings": [
      {
        "type": "zone|trend_line|price_line|forecast_path|channel|fib_retracement|baseline|marker|histogram_band",
        "confidence": 80,
        "label": "optional",
        "color": "optional #hex",
        "points": [{ "barsAhead": 0, "price": 1.085, "time": "optional unix sec" }]
      }
    ]
  },
  "clear_chart_payload": {
    "symbol": "MT5 symbol",
    "interval": "optional — switches chart timeframe before clear",
    "recommendation_id": "optional — limits delete to AICHART_{id}_*"
  },
  "idempotency": "The EA must remember the last acked command id and never execute the same command id twice."
}
