{
  "name": "AiChart EA Bridge API",
  "version": "1.0.0",
  "auth": {
    "scheme": "Bearer",
    "header": "Authorization",
    "value": "Bearer <EA_TOKEN>",
    "fallback_header": "X-EA-Token",
    "note": "Generate the token from AiChart → الإعدادات → الربط والتكامل → MetaTrader. Shown once."
  },
  "base_url": "https://aichart.lork.cloud",
  "endpoints": {
    "heartbeat": {
      "method": "POST",
      "path": "/api/ea/heartbeat",
      "interval_seconds": 2,
      "request": {
        "account": {
          "login": "string|number",
          "currency": "string",
          "balance": "number",
          "equity": "number",
          "broker": "string"
        },
        "symbols": [
          {
            "symbol": "EURUSD",
            "bid": 1.0853,
            "ask": 1.0854,
            "digits": 5,
            "point": 0.00001,
            "contract_size": 100000,
            "tick_value": 1.0,
            "tick_size": 0.00001,
            "min_lot": 0.01,
            "max_lot": 100.0,
            "lot_step": 0.01
          }
        ],
        "candles": {
          "symbol": "EURUSD",
          "interval": "1h",
          "bars": [{ "time": 1717000000, "open": 1.08, "high": 1.09, "low": 1.07, "close": 1.085 }]
        }
      },
      "response": {
        "ok": true,
        "server_time": "ISO8601",
        "commands": [
          {
            "id": 123,
            "type": "open_market",
            "payload": {
              "symbol": "EURUSD",
              "side": "buy",
              "lots": 0.10,
              "stop_loss": 1.08,
              "take_profit": 1.10
            }
          }
        ]
      }
    },
    "commands": {
      "method": "GET",
      "path": "/api/ea/commands",
      "note": "Alternative to commands embedded in the heartbeat response."
    },
    "ack": {
      "method": "POST",
      "path": "/api/ea/commands/{id}/ack",
      "request": {
        "status": "acked|failed",
        "result": { "ticket": 5566778, "price": 1.0854, "lots": 0.10, "error": "optional" }
      }
    }
  },
  "command_types": {
    "open_market": "Open a market order (side=buy|sell, lots, optional stop_loss/take_profit).",
    "close_position": "Close an open position by ticket.",
    "modify_sl_tp": "Modify stop loss / take profit of an open position."
  },
  "idempotency": "The EA must remember the last acked command id and never execute the same command id twice."
}
