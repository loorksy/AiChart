{
  "name": "AiChart EA Bridge API",
  "version": "3.0.0",
  "auth": {
    "scheme": "Bearer",
    "header": "Authorization",
    "value": "Bearer <EA_TOKEN>",
    "fallback_header": "X-EA-Token",
    "note": "Generate the token from AiChart → الإعدادات → الربط والتكامل → MetaTrader. Shown once."
  },
  "base_url": "https://aichart.lork.cloud",
  "ea_inputs_v2": {
    "ApiBase": "https://aichart.lork.cloud",
    "EaToken": "API key from AiChart settings",
    "HeartbeatSeconds": 30,
    "PollIntervalMs": 1000,
    "AllowNoSL": false,
    "MaxRetries": 3,
    "RetryDelayMs": 500,
    "AutoSync": true
  },
  "endpoints": {
    "heartbeat": {
      "method": "POST",
      "path": "/api/ea/heartbeat",
      "interval_seconds": 30,
      "request": {
        "account": {
          "login": "string|number",
          "currency": "string",
          "balance": "number",
          "equity": "number",
          "broker": "string",
          "trade_mode": "demo|live|contest"
        },
        "positions": [
          {
            "ticket": 7927833,
            "symbol": "EURUSD",
            "side": "sell",
            "lots": 0.01,
            "open_price": 1.085,
            "sl": 1.09,
            "tp": 1.08,
            "profit": -2.5
          }
        ],
        "symbols": [
          {
            "symbol": "EURUSD",
            "bid": 1.0853,
            "ask": 1.0854,
            "digits": 5,
            "point": 0.00001,
            "contract_size": 100000,
            "tick_value": 1.0,
            "tick_size": 0.00001,
            "min_lot": 0.01,
            "max_lot": 100.0,
            "lot_step": 0.01,
            "stops_level": 0,
            "freeze_level": 0,
            "trade_execution": "instant",
            "filling_mode": "ioc|fok",
            "spread_points": 8
          }
        ],
        "candles": {
          "symbol": "EURUSD",
          "interval": "1h",
          "bars": [{ "time": 1717000000, "open": 1.08, "high": 1.09, "low": 1.07, "close": 1.085 }]
        }
      },
      "response": {
        "ok": true,
        "server_time": "ISO8601",
        "flags": {
          "kill_switch": false,
          "close_open_trades": false
        },
        "commands": []
      },
      "notes": [
        "v2 EA polls GET /api/ea/commands for trade commands; heartbeat carries state + flags.",
        "Server reconciles positions[] into aichartTrades on each heartbeat.",
        "Offline threshold: 90s without heartbeat (EA_HEARTBEAT_TIMEOUT_MS)."
      ]
    },
    "commands": {
      "method": "GET",
      "path": "/api/ea/commands",
      "poll_interval_ms": 1000,
      "note": "Primary command delivery for EA v2. Marks commands as sent."
    },
    "ack": {
      "method": "POST",
      "path": "/api/ea/commands/{id}/ack",
      "request": {
        "status": "acked|failed",
        "result": { "ticket": 5566778, "price": 1.0854, "lots": 0.10, "error": "optional" }
      }
    },
    "chart_upload": {
      "method": "POST",
      "path": "/api/ea/chart-upload",
      "auth": "Bearer EA token",
      "content_type": "multipart/form-data",
      "request": {
        "recommendation_id": "number (required unless capture_key)",
        "capture_key": "string (optional, for ad-hoc snapshots e.g. snap_1717000000)",
        "chart": "PNG file field"
      },
      "response": {
        "ok": true,
        "path": "/data/charts/ea/{userId}/{id}.png"
      }
    },
    "quotes": {
      "method": "POST",
      "path": "/api/ea/quotes",
      "interval_seconds": 1,
      "note": "EA v3 live bid/ask push for Market Watch symbols."
    },
    "event": {
      "method": "POST",
      "path": "/api/ea/event",
      "note": "EA v3 immediate trade events (OnTradeTransaction)."
    }
  },
  "command_types": {
    "open_market": "Open a market order (side=buy|sell, lots, stop_loss required unless EA AllowNoSL).",
    "close_position": "Close an open position by ticket.",
    "modify_sl_tp": "Modify stop loss / take profit: { ticket, stop_loss, take_profit? }.",
    "draw_and_capture": "Clear prior AICHART_* objects, draw chart_drawings on MT5 chart, ChartScreenShot, upload PNG.",
    "clear_chart": "Delete all chart objects with prefix AICHART_{recommendation_id}_ (or all AICHART_* if no id).",
    "open_pending": "Pending order: { symbol, side, order_type: limit|stop|stop_limit, lots, price, stop_loss?, take_profit? }.",
    "cancel_order": "Cancel pending order: { ticket }.",
    "close_partial": "Partial close: { ticket, lots }.",
    "ensure_symbol": "SymbolSelect + wait for ticks: { symbol }.",
    "query_terminal": "Snapshot margin/equity/pending orders + reference_symbol trade_execution/filling_mode (v3.01+, result in ack)."
  },
  "modify_sl_tp_payload": {
    "ticket": "MT5 position ticket",
    "stop_loss": "new SL price",
    "take_profit": "optional new TP price"
  },
  "draw_and_capture_payload": {
    "symbol": "MT5 symbol — broker-exact case (EURUSDm); resolved via ResolveBrokerSymbol",
    "interval": "1m|5m|15m|30m|1h|4h|1d|1w or M1|H1|… — empty or chart = Period(); used for iTime() coords only (EA does NOT change chart symbol/period)",
    "recommendation_id": "number (links upload + object prefix AICHART_{id}_*)",
    "capture_key": "optional string when recommendation_id is 0",
    "entry": "optional number",
    "stop_loss": "optional number",
    "take_profit": "optional number",
    "drawings": [
      {
        "type": "semantic: price_line|trend_line|forecast_path|channel|zone|fib_retracement|baseline|marker|histogram_band — OR MT5-native: hline|vline|trend|rectangle|triangle|ellipse|arrow_*|fibo|fibo_fan|fibo_arc|pitchfork|expansion|gann_*|text|label",
        "confidence": 80,
        "label": "optional",
        "color": "optional #RRGGBB (EA HexToColor v3.09+)",
        "width": "optional 1-5",
        "style": "optional solid|dashed|dotted",
        "fill": "optional bool (rectangles/zones)",
        "fill_color": "optional #hex",
        "font_size": "optional",
        "arrow_code": "optional for type arrow",
        "points": [{ "barsAhead": 0, "price": 1.085, "time": "optional unix sec" }],
        "price": "optional flat Y (when no points[])",
        "price2": "optional second anchor",
        "time_offset": "optional bar index from current (alias barsAhead)",
        "time_offset2": "optional"
      }
    ],
    "poll_chart": "GET /api/agent/chart/{recommendation_id}/mt5 — 202 pending until PNG ready, then 200 image/png"
  },
  "clear_chart_payload": {
    "symbol": "MT5 symbol",
    "interval": "optional — unused for clear; objects deleted by recommendation_id prefix",
    "recommendation_id": "optional — limits delete to AICHART_{id}_*"
  },
  "idempotency": "The EA remembers recent acked command ids and never executes the same command id twice."
}
