QUANT_AGENT_HOST=0.0.0.0
QUANT_AGENT_PORT=8091
# Required in production; generate at least 32 random characters.
QUANT_AGENT_INTERNAL_TOKEN=
QUANT_AGENT_ENV=development
QUANT_AGENT_WORK_DIR=.quant-agent/work
QUANT_AGENT_MAX_REQUEST_BYTES=2097152
QUANT_AGENT_LOG_LEVEL=info
# This service makes no outbound HTTP calls, ever. Market bars only ever
# arrive by being POSTed to it. "disabled" is the only mode that should ever
# be used; it exists as an explicit, auditable setting rather than an
# implicit assumption.
QUANT_AGENT_NETWORK_MODE=disabled
# sqlite is the only backing store this service ships (recommendations must
# be retrievable by id after creation); the value is still read so it can be
# asserted in health/ready and to match research-service's env shape.
QUANT_AGENT_STORAGE=sqlite
QUANT_AGENT_DB_PATH=.quant-agent/work/quant-agent.sqlite3

# ─── Decision engine tuning ─────────────────────────────────────
# Bars required before EMA200 etc. are considered reliable enough to
# evaluate strategies against.
QUANT_AGENT_MIN_BARS=210
# Upper bound on bars accepted per request (defense in depth; the request
# body size limit above also applies).
QUANT_AGENT_MAX_BARS=2000
# A recommendation's validity window, in bars of the source interval.
QUANT_AGENT_VALIDITY_BARS=6
