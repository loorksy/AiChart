# ─── AiChart environment variables ───────────────────────────────
# Copy this file to `.env` and fill in real values before deploying.

# 32-byte key as 64 hex characters. Used to encrypt Binance API secrets.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Secret used to sign session tokens (JWT). Use a long random string.
# Generate with:  openssl rand -base64 48
APP_SECRET=

# Bootstrap admin account, created automatically on first run.
ADMIN_EMAIL=admin@aichart.local
ADMIN_PASSWORD=change-this-password

# SQLite database file path (relative to the web/ directory).
DB_PATH=data/aichart.db

# ─── Phase 2 (expert agent) ───────────────────────────────────────
# Platform-wide Claude key (model option أ). Chat/recommendations are
# disabled until this is set.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-3-5-sonnet-latest).
ANTHROPIC_MODEL=

# Binance Skills Hub — official execution skill (binance-cli), READ-ONLY tool.
# Disabled by default. Set to 1 to let the agent fetch extended Binance data.
# Order execution always stays on the Risk Guard path, never via the CLI.
ENABLE_BINANCE_CLI=0

# ─── Phase 5 (Telegram notifications) ─────────────────────────────
# Bot token from @BotFather. Telegram features are disabled until set.
TELEGRAM_BOT_TOKEN=
# Optional: bot username (otherwise fetched via getMe).
TELEGRAM_BOT_USERNAME=
# Secret used to verify incoming webhook calls (set when registering webhook).
TELEGRAM_WEBHOOK_SECRET=
