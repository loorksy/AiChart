# ─── AiChart environment variables ───────────────────────────────
# Copy this file to `.env` and fill in real values before deploying.

# 32-byte key as 64 hex characters. Used to encrypt Binance API secrets.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Secret used to sign session tokens (JWT). Use a long random string.
# Generate with:  openssl rand -base64 48
APP_SECRET=

# Bootstrap admin account, created automatically on first run.
ADMIN_EMAIL=loorksy@gmail.com
ADMIN_PASSWORD=change-this-password

# SQLite database file path (relative to the web/ directory).
# Used when DATABASE_URL is not set (local development).
DB_PATH=data/aichart.db

# PostgreSQL connection string (production). When set, SQLite is not used.
# Example: postgresql://aichart:secret@localhost:5432/aichart
DATABASE_URL=

# ─── Phase 2 (expert agent) ───────────────────────────────────────
# Platform-wide Claude key (model option أ). Chat/recommendations are
# disabled until this is set.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-3-5-sonnet-latest).
ANTHROPIC_MODEL=
# Google Gemini (AI_PROVIDER=google) — from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Binance Skills Hub — official execution skill (binance-cli), READ-ONLY tool.
# Disabled by default. Set to 1 to let the agent fetch extended Binance data.
# Order execution always stays on the Risk Guard path, never via the CLI.
ENABLE_BINANCE_CLI=0

# ─── Telegram (outbound notifications + Login Widget) ─────────────
# Bot token from @BotFather. Outbound notifications + Login Widget only.
# Trading conversation: Claude MCP (see docs/MCP_CLAUDE_SETUP.md).
TELEGRAM_BOT_TOKEN=
# Optional: bot username (otherwise fetched via getMe). Required for Login Widget.
TELEGRAM_BOT_USERNAME=
# In @BotFather: /setdomain — add your site domain so Telegram Login works.

# ─── Phase 6 (24/7 ops) ───────────────────────────────────────────
# Protects /api/cron/* endpoints. Generate with: openssl rand -base64 32
CRON_SECRET=

# Public URL of your deployment (for Telegram webhook registration).
APP_URL=http://localhost:3000

# ─── Agent bridge (MCP + single-user mode) ────────────────────────
# Multi-user signup is ON by default. Set 1 for single-operator mode (registration disabled).
AICHART_SINGLE_USER=0
# Master password for the single-password login gate (single-user mode).
# Falls back to the operator's account password when unset.
AICHART_GATE_PASSWORD=Ahmetlork0009
# Service token for /api/agent/* (MCP server uses this).
# Generate with: openssl rand -hex 32   (min 16 chars; bridge is OFF until set)
AICHART_SERVICE_TOKEN=
# Optional: force the operator user id (defaults to the first admin account).
AICHART_AGENT_USER_ID=

# ─── Bridge infrastructure (MCP /api/agent/*) ─────────────────────
# Default TTL for in-memory bridge cache entries (ms).
BRIDGE_CACHE_TTL_MS=5000
# Max write requests per user per route per minute (sliding window).
BRIDGE_RATE_LIMIT_WRITES=10
# Quote freshness threshold (ms) — used by bridge/freshness helpers.
STALE_QUOTE_MS=5000
# Max forex spread (pips) before open_trade pre-flight rejects.
MAX_SPREAD_PIPS=30
# Idempotency key retention for agent write endpoints (hours).
IDEMPOTENCY_TTL_HOURS=24
# Redis — shared bridge cache + rate limit + EA-quote L2 + cross-instance
# lock backing. REQUIRED in production once more than one web/worker replica
# runs (otherwise cache/locks are per-process and cron may double-run).
REDIS_URL=redis://127.0.0.1:6379/0
# Log per-symbol quote tick gaps on ingest (debug / quote staleness investigation)
# EA_QUOTE_METRICS_LOG=1
# REDIS_PASSWORD=

# ─── Cloud-scale tuning (safe defaults shown) ─────────────────────
# Outbound call timeouts (ms): total budget for non-streaming LLM calls,
# inactivity budget for streaming, and a general external-HTTP budget.
# LLM_TIMEOUT_MS=120000
# LLM_IDLE_TIMEOUT_MS=60000
# HTTP_TIMEOUT_MS=30000
# Postgres connection pool (per process). Lower max when running many replicas
# behind one server; raise behind a PgBouncer pooler.
# PGPOOL_MAX=10
# PGPOOL_IDLE_MS=30000
# PGPOOL_CONN_TIMEOUT_MS=10000
# PGSSL=1                 # or append ?sslmode=require to DATABASE_URL
# Absolute base URL the in-process agent uses to reach its own /api/agent/*
# routes. Set this behind a load balancer / multi-host deploy (defaults to
# http://127.0.0.1:$PORT which only works when web is co-located).
# AICHART_SELF_URL=https://your-domain

# ─── AiChart MCP Server (Claude Connectors) ───────────────────────
# Remote MCP URL for claude.ai → Customize → Connectors.
MCP_PUBLIC_URL=https://aichart.lork.cloud/mcp
MCP_PORT=8787
# Shared secret: MCP process + web /api/admin/mcp-auth/verify
# Generate with: openssl rand -hex 32
MCP_AUTH_SECRET=
# oauth (production) | none (local dev only — never with real trading)
MCP_AUTH_MODE=oauth
# OAuth token lifetime (days) — survives pm2 restart (JWT + SQLite refresh)
MCP_ACCESS_TOKEN_TTL_DAYS=365
MCP_REFRESH_TOKEN_TTL_DAYS=365
# MCP_ALLOWED_HOSTS=aichart.lork.cloud

# Agent wake via Telegram [EVENT:…] — off by default (MCP conversational mode).
# AGENT_WAKE_ENABLED=1

# ─── Forex execution backend ─────────────────────────────────────
# Force backend: ea | metaapi | mt5local (optional — auto-detect if unset)
# Priority when unset: MT5_BRIDGE_URL → METAAPI_TOKEN → ea
FOREX_BACKEND=ea

# ─── Self-hosted MT5 bridge (Linux Docker/Wine — experimental) ───
# When set without FOREX_BACKEND=ea, switches to mt5local (settings login form).
# Not recommended on Linux/Wine (IPC timeout). Prefer FOREX_BACKEND=ea + Windows MT5.
# Docker (web in compose): http://mt5:18812 · pm2 host: http://localhost:18812
# MT5_BRIDGE_URL=
# MT5_BRIDGE_TOKEN=

# ─── Binance chart capture (Playwright) ───────────────────────────
# Screenshot from binance.com for MCP / console. Requires Chromium.
# Local:  npm run playwright:setup   then set BINANCE_CAPTURE_ENABLED=1
# Docker: enabled automatically in infra/Dockerfile when using bookworm image.
BINANCE_CAPTURE_ENABLED=0
# BINANCE_CAPTURE_TIMEOUT_MS=25000
# BINANCE_CAPTURE_CACHE_SEC=60
# BINANCE_CAPTURE_DEFAULT_MARKET=futures
# BINANCE_CAPTURE_WIDTH=1440
# BINANCE_CAPTURE_HEIGHT=900
# PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
