# ─── AiChart environment variables ───────────────────────────────
# Copy this file to `.env` and fill in real values before deploying.

# 32-byte key as 64 hex characters. Used to encrypt stored broker secrets.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Secret used to sign session tokens (JWT). Use a long random string.
# Generate with:  openssl rand -base64 48
APP_SECRET=

# Bootstrap admin account, created automatically on first run.
# Both values are required for bootstrap; no built-in credentials exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SQLite database file path (relative to the web/ directory).
# Used when DATABASE_URL is not set (local development).
DB_PATH=data/aichart.db

# PostgreSQL connection string (production). When set, SQLite is not used.
# Example: postgresql://aichart:secret@localhost:5432/aichart
DATABASE_URL=

# ─── Expert agent (LLM provider) ──────────────────────────────────
# Platform-wide OpenAI key. Chat/analysis/recommendations are disabled
# until this is set (also configurable via admin platform config).
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4.1). Platform config: AI_MODEL.
AI_MODEL=
# Google Gemini — used for audio transcription only (voice notes).
GEMINI_API_KEY=

# ─── Market data / broker providers ───────────────────────────────
# OANDA is the only forex/gold chart-data source (warehouse-first reads).
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice | live
OANDA_ENV=practice
# Optional MetaApi token (FOREX_BACKEND=metaapi).
# METAAPI_TOKEN=
# News/macro provider (News & Macro Risk agent) — optional.
# FMP_API_KEY=

# ─── Telegram (outbound notifications + Login Widget) ─────────────
# Bot token from @BotFather. Outbound notifications + Login Widget only.
TELEGRAM_BOT_TOKEN=
# Optional: bot username (otherwise fetched via getMe). Required for Login Widget.
TELEGRAM_BOT_USERNAME=
# In @BotFather: /setdomain — add your site domain so Telegram Login works.

# ─── Phase 6 (24/7 ops) ───────────────────────────────────────────
# Protects /api/cron/* endpoints. Generate with: openssl rand -base64 32
CRON_SECRET=

# Public URL of your deployment (for Telegram webhook registration).
APP_URL=http://localhost:3000

# ─── Agent bridge (MCP + single-user mode) ────────────────────────
# Multi-user signup is ON by default. Set 1 for single-operator mode (registration disabled).
AICHART_SINGLE_USER=0
# Master password for the single-password login gate (single-user mode).
# Falls back to the operator's account password when unset.
AICHART_GATE_PASSWORD=
# Service token for /api/agent/* (MCP server uses this).
# Generate with: openssl rand -hex 32   (min 16 chars; bridge is OFF until set)
AICHART_SERVICE_TOKEN=
# Optional: force the operator user id (defaults to the first admin account).
AICHART_AGENT_USER_ID=

# ─── Bridge infrastructure (MCP /api/agent/*) ─────────────────────
# Default TTL for in-memory bridge cache entries (ms).
BRIDGE_CACHE_TTL_MS=5000
# Max write requests per user per route per minute (sliding window).
BRIDGE_RATE_LIMIT_WRITES=10
# Quote freshness threshold (ms) — used by bridge/freshness helpers.
STALE_QUOTE_MS=5000
# Max forex spread (pips) before open_trade pre-flight rejects.
MAX_SPREAD_PIPS=30
# Idempotency key retention for agent write endpoints (hours).
IDEMPOTENCY_TTL_HOURS=24
# Redis — shared bridge cache + rate limit + EA-quote L2 + cross-instance
# lock backing. REQUIRED in production once more than one web/worker replica
# runs (otherwise cache/locks are per-process and cron may double-run).
REDIS_URL=redis://127.0.0.1:6379/0
# Log per-symbol quote tick gaps on ingest (debug / quote staleness investigation)
# EA_QUOTE_METRICS_LOG=1
# REDIS_PASSWORD=        # REQUIRED in production / any non-loopback Redis

# ─── Cloud-scale tuning (safe defaults shown) ─────────────────────
# Outbound call timeouts (ms): total budget for non-streaming LLM calls,
# inactivity budget for streaming, and a general external-HTTP budget.
# LLM_TIMEOUT_MS=120000
# LLM_IDLE_TIMEOUT_MS=60000
# HTTP_TIMEOUT_MS=30000
# Postgres connection pool (per process). Lower max when running many replicas
# behind one server; raise behind a PgBouncer pooler.
# PGPOOL_MAX=10
# PGPOOL_IDLE_MS=30000
# PGPOOL_CONN_TIMEOUT_MS=10000
# PGSSL=1                 # or append ?sslmode=require to DATABASE_URL
# PGSSL_INSECURE=1        # skip TLS cert verification (self-signed dev DB only)
# Absolute base URL the in-process agent uses to reach its own /api/agent/*
# routes. Set this behind a load balancer / multi-host deploy (defaults to
# http://127.0.0.1:$PORT which only works when web is co-located).
# AICHART_SELF_URL=https://your-domain

# ─── Observability ────────────────────────────────────────────────
# Prometheus scrape protection (optional). When set, GET /api/metrics needs
# Authorization: Bearer <token> or ?token=. Leave unset on a private network.
# METRICS_TOKEN=
# Error reporting — forward exceptions to Sentry when a DSN is provided.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# Worker tier concurrency (jobs processed in parallel per worker process).
# WORKER_CONCURRENCY=5
# Structured logs: LOG_LEVEL=debug|info|warn|error  ·  LOG_FORMAT=json|pretty
# LOG_LEVEL=info
# LOG_FORMAT=json

# ─── Isolated Research Service (Phase 2, disabled by default) ───────────────
RESEARCH_SERVICE_ENABLED=0
RESEARCH_SWARM_ENABLED=0
RESEARCH_SWARM_PRESETS_ENABLED=0
# Server-only URL and token. Never use a NEXT_PUBLIC_ prefix.
RESEARCH_SERVICE_URL=http://127.0.0.1:8090
RESEARCH_SERVICE_INTERNAL_TOKEN=
# Bounded web-to-service request timeout in milliseconds (100-30000).
RESEARCH_SERVICE_CLIENT_TIMEOUT_MS=10000
# Generic research jobs use SQLite in production and memory in development/test.
RESEARCH_SERVICE_STORAGE=sqlite
RESEARCH_SERVICE_JOB_DB_PATH=/var/lib/aichart-research/work/research-jobs.sqlite3
# Phase 3 deterministic backtesting and validation remain independently disabled.
RESEARCH_BACKTEST_ENABLED=0
RESEARCH_VALIDATION_ENABLED=0

# Agent rollouts. Keep safety guards enabled; experimental persistence is opt-in.
FEATURE_SMART_CHART_AGENT=1
FEATURE_CANDLE_WAREHOUSE=1
FEATURE_NEWS_MACRO_AGENT=1
FEATURE_AGENT_EXECUTION_GUARD=1
FEATURE_MCP_UNIFIED_ENGINE=1
# Skill discovery + lazy loading into agent prompts (read-only guidance).
FEATURE_AGENT_SKILLS=1
# Bounded conversation context + redacted run tracing (both degrade safely).
AGENT_CONTEXT_V2=1
AGENT_RUN_TRACE_V1=1
# Memory candidate writes stay opt-in.
AGENT_MEMORY_WRITE_V1=0

# Exact deployed commit — injected by deploy tooling / Docker build args.
# Bare-metal git checkouts resolve it automatically from .git when unset.
# GIT_COMMIT=

# ─── AiChart MCP Server (Claude Connectors) ───────────────────────
# Remote MCP URL for claude.ai → Customize → Connectors.
MCP_PUBLIC_URL=https://aichart.lork.cloud/mcp
MCP_PORT=8787
# Shared secret: MCP process + web /api/admin/mcp-auth/verify
# Generate with: openssl rand -hex 32
MCP_AUTH_SECRET=
# oauth (production) | none (local dev only — never with real trading)
MCP_AUTH_MODE=oauth
# OAuth token lifetime (days) — survives pm2 restart (JWT + SQLite refresh)
MCP_ACCESS_TOKEN_TTL_DAYS=365
MCP_REFRESH_TOKEN_TTL_DAYS=365
# MCP_ALLOWED_HOSTS=aichart.lork.cloud

# Agent wake via Telegram [EVENT:…] — off by default (MCP conversational mode).
# AGENT_WAKE_ENABLED=1

# ─── Forex execution backend ─────────────────────────────────────
# Force backend: ea | metaapi | mt5local (optional — auto-detect if unset)
# Priority when unset: MT5_BRIDGE_URL → METAAPI_TOKEN → ea
FOREX_BACKEND=ea

# Forex market-data source (candles, instruments, live price). OANDA = no EA bridge for charts.
# Requires OANDA_API_TOKEN + OANDA_ACCOUNT_ID in .env (or platform_config).
FOREX_DATA_SOURCE=oanda

# ─── Self-hosted MT5 bridge (Linux Docker/Wine — experimental) ───
# When set without FOREX_BACKEND=ea, switches to mt5local (settings login form).
# Not recommended on Linux/Wine (IPC timeout). Prefer FOREX_BACKEND=ea + Windows MT5.
# Docker (web in compose): http://mt5:18812 · pm2 host: http://localhost:18812
# MT5_BRIDGE_URL=
# MT5_BRIDGE_TOKEN=

# ─── Chart capture (Playwright, browse_web tool) ─────────────────
# PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# TradingView TA bridge (Python tradingview-ta via infra/tradingview/bridge.py)
# Requires: pip install tradingview-ta  +  py available on PATH
TRADINGVIEW_MCP_ENABLED=0
# OANDA historical warehouse maintenance (comma-separated; existing series are
# also discovered automatically). Run POST /api/cron/candle-warehouse.
CANDLE_SYNC_SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURGBP,EURJPY,GBPJPY,XAUUSD,XAGUSD
CANDLE_SYNC_INTERVALS=1m,5m,15m,30m,1h,4h,1d
CANDLE_SYNC_MAX_SERIES=15

# Mass-backtest pipeline (cron /api/cron/strategy-pipeline; REQUIRES REDIS_URL).
# Fills the strategy catalog with validated evidence — gates stay untouched.
STRATEGY_PIPELINE_USER_ID=
STRATEGY_PIPELINE_SYMBOLS=XAUUSD
# Scalping is the product priority: 1m/5m lead, 15m is the ceiling.
STRATEGY_PIPELINE_TIMEFRAMES=1m,5m,15m
STRATEGY_PIPELINE_BATCH=2
# Per-job research timeout; raise RESEARCH_SERVICE_MAX_TIMEOUT_SECONDS on the
# container to match when using 50k-bar samples.
STRATEGY_BACKTEST_TIMEOUT_SECONDS=600
# Historical pages pulled per series per cron tick (each page ≤ ~4500 bars).
CANDLE_SYNC_MAX_PAGES=5
# Rolling temporal depth retained for every major timeframe (1m→1d).
CANDLE_HISTORY_YEARS=5
BACKTEST_COST_QUOTE_MAX_AGE_MS=120000
# Used only when a fresh EA/MT5 execution quote is unavailable.
# BACKTEST_SPREAD_PIPS=1.2
# BACKTEST_SLIPPAGE_PIPS=0.6
# BACKTEST_COMMISSION_PER_LOT_SIDE_USD=3.5
