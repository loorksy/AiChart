# AiChart scheduled jobs — install to /etc/cron.d/aichart
# Replace YOUR_DOMAIN and YOUR_CRON_SECRET before deploying.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

*/10 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/event-monitor >/dev/null 2>&1

# Recommendation-tracker sweep — every 5 min. Evaluates all non-terminal tracked
# recommendations against fresh warehouse candles (no browser, no LLM, no trade
# execution). Overlap-safe via a distributed lease lock, so an occasional long
# run is skipped rather than double-processed.
*/5 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/recommendation-sweep >/dev/null 2>&1

# Candle-warehouse maintenance — every 10 min. Incrementally backfills ~5y of
# linked-account broker history, repairs open-market gaps, prunes bars older than 5y, and logs a
# completeness report (first/last candle + gap counts). GET the same path for a
# read-only report. Overlap-safe via the route's distributed lease.
*/10 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/candle-warehouse >/dev/null 2>&1

# Strategy mass-backtest pipeline — every 10 min. Advances in-flight backtests
# through the evidence state machine and submits missing catalog combos
# (batch-paced for the single-concurrency research container). No-ops without
# REDIS_URL. GET the same path for state counts + gate-failure reasons.
*/10 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/strategy-pipeline >/dev/null 2>&1

# Historical case-memory indexer — every 15 min. Walks the warehouse in sliding
# windows, describes each moment from candles at or before it, and fills in what
# the following bars did once that window has actually arrived. No LLM, no trade
# execution. Round-robins across series so none starves; overlap-safe via a
# distributed lease. GET the same path for per-series coverage.
*/15 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/case-memory >/dev/null 2>&1

# OPTIONAL — 24/7 opportunity monitor. Left unscheduled on purpose: it runs an
# LLM-heavy scan per active user, and the maintenance work it shares with
# event-monitor already runs above. The same scan is available on demand at
# /api/opportunities/scan. Uncomment only if you want the recurring cost.
# */30 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/monitor >/dev/null 2>&1

# Daily Telegram summary at 20:00 UTC + MEMORY wake (one AI call/day)
0 20 * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/daily-summary >/dev/null 2>&1

# Nightly tradability calibration report — declared reachability verdicts vs
# realized activation, per verdict. Read-only; feeds TRADABILITY_LIMITS tuning
# (docs/PLATFORM_AGENT_UPGRADE_PLAN.md §1.5).
30 21 * * * root curl -sS -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/tradability-calibration >/dev/null 2>&1

# Weekly rollout report (plan §17) — Sundays 18:00 UTC. Aggregates the critical
# invariants (hidden WAIT, wrong-mode execution, unexplained parity), 7-day
# revision/re-evaluation activity from the tables, and process counters, then
# sends one Telegram message per operator. GET the same path for a preview.
0 18 * * 0 root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/weekly-report >/dev/null 2>&1

# Quant Agent scan — every 15 min. A second, fully independent recommendation
# engine (isolated quant-agent service, recommend-only, no trade execution).
# Loops QUANT_AGENT_WATCHLIST symbols x a fixed interval set, no-ops cleanly
# when QUANT_AGENT_SERVICE_ENABLED is not 1. Overlap-safe via a lease lock.
*/15 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/quant-agent-scan >/dev/null 2>&1

# Quant Agent "AI Scheduled Monitors" sweep — every 15 min. Per-user monitor
# rows (symbol/interval/notify channels) re-run the same isolated quant-agent
# recommendation engine on their own due schedule and deliver a real
# Telegram/push/webhook notification when the recommendation actually
# changes. Overlap-safe via a lease lock; no-ops cleanly when
# QUANT_AGENT_SERVICE_ENABLED is not 1 or no monitors are enabled.
*/15 * * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/quant-agent-monitors >/dev/null 2>&1

# Quant Agent analysis outcome validation — daily at 03:20 UTC. Scores stored
# LLM analyses older than 7 days against the price the symbol actually reached
# (BUY right above +2%, SELL right below -2%, HOLD right within ±5%) and writes
# the verdict back, which is what later runs recall as memory. Ends with a
# READ-ONLY threshold calibration report in the response and the log; nothing
# is auto-tuned. Daily, not every 15 min, because a row becomes scorable once
# and only ages into the batch on a day boundary. No-ops cleanly when
# QUANT_AGENT_SERVICE_ENABLED is not 1. Overlap-safe via a lease lock.
20 3 * * * root curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/quant-analysis-validate >/dev/null 2>&1

# than 14 days so stale history never bloats disk or future context.
