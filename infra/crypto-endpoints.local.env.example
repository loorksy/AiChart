# Copy to infra/crypto-endpoints.local.env (gitignored) on the VPS.
# deploy-vps.sh merges missing keys into web/.env on deploy.
#
# Spot signed API (global region)
CRYPTO_SPOT_API_PROD=https://your-spot-api-host
CRYPTO_SPOT_API_TESTNET=https://your-spot-testnet-host
# Public market data (klines, exchangeInfo, tickers)
CRYPTO_PUBLIC_DATA_PROD=https://your-public-data-host
CRYPTO_PUBLIC_DATA_TESTNET=https://your-public-data-testnet-host
# USDT-M futures
CRYPTO_FUTURES_API_PROD=https://your-futures-api-host
CRYPTO_FUTURES_API_TESTNET=https://your-futures-testnet-host
# Regional spot APIs (optional — only if users connect US/TR keys)
CRYPTO_REGION_US_API=https://your-us-spot-api-host
CRYPTO_REGION_TR_API=https://your-tr-spot-api-host
# Live prices WebSocket (combined stream endpoint base, no trailing slash)
CRYPTO_WS_STREAM=wss://your-stream-host/stream
# On-chain market intelligence (Web3 public API base)
CRYPTO_WEB3_API_BASE=https://your-web3-api-host
# Playwright chart capture page URLs ({pair} or {symbol} placeholder)
CRYPTO_CHART_SPOT_URL=https://your-chart-host/en/trade/{pair}?type=spot
CRYPTO_CHART_FUTURES_URL=https://your-chart-host/en/futures/{symbol}
