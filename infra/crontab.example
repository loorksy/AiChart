# AiChart cron jobs — see infra/aichart.cron
#
# This file used to carry its own copy of the schedule and drifted out of sync
# with it: it listed a job as required that is deliberately optional, and omitted
# three that were added since (event-monitor, strategy-pipeline, case-memory).
# Two files describing one schedule is a trap, so the installable file is now the
# only source.
#
#   sudo cp infra/aichart.cron /etc/cron.d/aichart
#   sudo sed -i 's/YOUR_DOMAIN/your.domain/; s/YOUR_CRON_SECRET/<secret>/' /etc/cron.d/aichart
#
# For a user crontab instead of /etc/cron.d, copy the schedule lines out of
# infra/aichart.cron and drop the leading `root` field from each.
