# AiChart cron jobs — replace YOUR_DOMAIN and CRON_SECRET
# Event-driven monitor (code only; wakes agent on Telegram events)
*/10 * * * * curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/event-monitor

# Daily summary + MEMORY wake (once/day)
0 20 * * * curl -sS -X POST -H "Authorization: Bearer YOUR_CRON_SECRET" https://YOUR_DOMAIN/api/cron/daily-summary
