# Copy to keystore.properties (gitignored) and fill in.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/lonora-admin.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias lonora-admin
storeFile=keystore/lonora-admin.jks
storePassword=change-me
keyAlias=lonora-admin
keyPassword=change-me
