RESEARCH_SERVICE_HOST=0.0.0.0
RESEARCH_SERVICE_PORT=8090
# Required in production; generate at least 32 random characters.
RESEARCH_SERVICE_INTERNAL_TOKEN=
RESEARCH_SERVICE_ENV=development
RESEARCH_SERVICE_WORK_DIR=.research/work
RESEARCH_SERVICE_ARTIFACT_DIR=.research/artifacts
RESEARCH_SERVICE_MAX_CONCURRENT_JOBS=2
RESEARCH_SERVICE_MAX_QUEUED_JOBS=32
RESEARCH_SERVICE_DEFAULT_TIMEOUT_SECONDS=30
RESEARCH_SERVICE_MAX_TIMEOUT_SECONDS=300
RESEARCH_SERVICE_MAX_RETRIES=2
RESEARCH_SERVICE_MAX_REQUEST_BYTES=65536
RESEARCH_SERVICE_MAX_ARTIFACT_BYTES=1048576
RESEARCH_SERVICE_LOG_LEVEL=info
RESEARCH_SERVICE_NETWORK_MODE=disabled
